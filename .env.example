# Notion API
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Gmail SMTP (enable 2FA and generate App Password at myaccount.google.com/apppasswords)
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# LLM Provider and Model
# For Navigator AI (UF): MODEL_PROVIDER=openai, MODEL_NAME=gpt-oss-120b, LLM_BASE_URL=https://api.ai.it.ufl.edu
# For Anthropic: MODEL_PROVIDER=anthropic, MODEL_NAME=claude-sonnet-4-5, leave LLM_BASE_URL empty
MODEL_PROVIDER=openai
MODEL_NAME=gpt-oss-120b
LLM_API_KEY=
LLM_BASE_URL=https://api.ai.it.ufl.edu

# Follow-up schedule (in days)
FOLLOWUP_DAYS_1=4
FOLLOWUP_DAYS_2=8
FOLLOWUP_DAYS_3=14

# Limits
MAX_EMAILS_PER_RUN=20

# Your name (used in email templates)
YOUR_NAME=
